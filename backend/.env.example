# Uygulama
PORT=3001

# Veritabanı (değerler kök dizindeki .env ile uyumlu olmalı)
DATABASE_URL="postgresql://fts_user:change_me@localhost:5432/financial_transaction_system?schema=public"

# CORS: frontend origin'leri, virgülle ayrılmış (ör. http://localhost:3000,https://panel.example.com)
CORS_ORIGINS=http://localhost:3000

# JWT
# En az 32 karakter, tahmin edilemez bir değer olmalıdır. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
# Token geçerlilik süresi (saniye, 60 - 86400)
JWT_EXPIRES_IN_SECONDS=3600

# Demo yönetici hesabı (kullanıcı tablosu yoktur)
# Aşağıdaki hash, demo parolası "ChangeMe!2026" içindir. Yalnızca yerel geliştirme
# için kullanın; gerçek ortamda kendi parolanızın hash'ini üretin:
#   npm run auth:hash-password -- "<parola>"
# Hash '$' karakterleri içerdiği için tek tırnak içinde yazılmalıdır.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$12$3OnkL3n4BTTTnr7GUo4z4e30iqEbxN1dFbDrux4coqK262qNM2.r6'

# Rate limiting: IP başına dakikadaki istek sayısı (login için ayrıca dakikada 5 deneme sınırı vardır)
RATE_LIMIT_PER_MINUTE=100
