# =============================================================================
# Docker Compose ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyalayıp değerleri düzenleyin:  cp .env.example .env
# ".env" dosyası Git'e gönderilmez (.gitignore).
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=fts_user
# Bağlantı adresinde (DATABASE_URL) kullanıldığı için yalnızca harf, rakam,
# "-" ve "_" içeren bir parola seçin.
POSTGRES_PASSWORD=change_me
POSTGRES_DB=financial_transaction_system
POSTGRES_PORT=5432

# --- Bilgisayarınızda yayınlanan portlar ---
BACKEND_PORT=3001
FRONTEND_PORT=3000

# --- Backend ---
# En az 32 karakter, tahmin edilemez bir değer olmalıdır. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
# Token geçerlilik süresi (saniye, 60 - 86400)
JWT_EXPIRES_IN_SECONDS=3600
# IP başına dakikadaki istek sayısı (login için ayrıca dakikada 5 deneme sınırı vardır)
RATE_LIMIT_PER_MINUTE=100

# --- Demo yönetici hesabı (kullanıcı tablosu yoktur) ---
# Aşağıdaki hash, demo parolası "ChangeMe!2026" içindir. Yalnızca yerel/demo
# kullanım içindir; gerçek ortamda kendi parolanızın hash'ini üretin:
#   cd backend && npm run auth:hash-password -- "<parola>"
# Hash '$' karakterleri içerdiği için tek tırnak içinde yazılmalıdır.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$12$3OnkL3n4BTTTnr7GUo4z4e30iqEbxN1dFbDrux4coqK262qNM2.r6'

# --- İsteğe bağlı ---
# Varsayılanlar: CORS_ORIGINS=http://localhost:${FRONTEND_PORT}
#                NEXT_PUBLIC_API_URL=http://localhost:${BACKEND_PORT}
# Uygulamayı farklı bir alan adından yayınlıyorsanız tanımlayın.
# NEXT_PUBLIC_API_URL değişirse frontend imajı yeniden derlenmelidir (--build).
# CORS_ORIGINS=https://panel.example.com
# NEXT_PUBLIC_API_URL=https://api.example.com
